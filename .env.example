# 任意: 設定するとライブのGemini反証（番人＋目付の二段エージェント）が有効になる。
# 未設定ならサンプル応答で動作（デモモード）
GEMINI_API_KEY=

# 任意: 反証に使うモデル（既定: gemini-2.5-flash）
SEKISHO_MODEL=

# 任意: 台帳ストア（既定: Cloud Run上=firestore / ローカル=file）
SEKISHO_STORE=

# 任意: ファイルストアの保存先（既定: ./data）
SEKISHO_DATA_DIR=

# 任意: Firestoreコレクション名（既定: sekisho-tegata）
SEKISHO_COLLECTION=
