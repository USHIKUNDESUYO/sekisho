# 任意: 設定するとライブのGemini反証（番人＋目付の二段エージェント）が有効になる。
# 未設定ならサンプル応答で動作（デモモード）
GEMINI_API_KEY=

# 任意: 反証に使うモデル（既定: gemini-2.5-flash）
SEKISHO_MODEL=

# 任意: 台帳ストア（既定: Cloud Run上=firestore / ローカル=file）
SEKISHO_STORE=

# 任意: ファイルストアの保存先（既定: ./data）
SEKISHO_DATA_DIR=

# 任意: Firestoreコレクション名（既定: sekisho-tegata）
SEKISHO_COLLECTION=

# 反証セッションの署名鍵（複数インスタンス運用では必須。単一なら自動生成にフォールバック）
SEKISHO_SIGNING_SECRET=

# 本番ゲートを開けるレビュアーの登録（形式: token1:名前1,token2:名前2）
# 実運用ではここを企業のSSO/OAuth/mTLSに差し替える
SEKISHO_REVIEWER_TOKENS=

# PoCデモ用の公開レビュアートークン（審査員が本番相当の手形を体験できるよう1つ開ける）
SEKISHO_DEMO_REVIEWER_TOKEN=

# 1にするとサンプル応答の手形でも本番ゲートを通す（既定は不通過）
SEKISHO_GATE_ALLOW_SAMPLE=

# 1にすると自己承認（変更者=裁き手）の手形でも本番ゲートを通す（既定は不通過）
SEKISHO_GATE_ALLOW_SELF_APPROVAL=
